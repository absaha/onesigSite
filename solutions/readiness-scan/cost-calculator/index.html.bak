              <td class="px-5 py-4"><span class="inline-flex items-center gap-1 rounded-full bg-amber-50 px-2 py-0.5 text-[11px] font-semibold text-amber-700 ring-1 ring-amber-200">Incomplete</span></td>
              <td class="px-5 py-4 text-neutral-700">Master data</td>
