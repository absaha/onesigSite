<!-- ============ ONE-PAGE SUMMARY MODAL ============ -->
<div id="summary-modal" class="fixed inset-0 z-[100] hidden items-start justify-center overflow-y-auto bg-black/60 p-4 backdrop-blur-sm" aria-modal="true" role="dialog">
  <div class="relative my-8 w-full max-w-2xl rounded-3xl border border-black/10 bg-white shadow-2xl">
    <button type="button" id="close-summary" aria-label="Close" class="absolute right-4 top-4 z-10 grid h-9 w-9 place-items-center rounded-full bg-neutral-100 text-neutral-700 hover:bg-neutral-200">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M6 6l12 12"/><path d="M18 6L6 18"/></svg>
    </button>

    <!-- FORM STATE -->
    <div id="modal-form-view">
      <!-- Header -->
      <div class="px-7 pb-5 pt-8 md:px-9">
        <div class="eyebrow mb-3">One-page summary</div>
        <h3 class="text-2xl font-semibold tracking-[-0.02em] text-neutral-900 md:text-3xl">Create your one-page summary.</h3>
        <p class="mt-3 text-sm leading-6 text-neutral-600">We will use the assumptions currently selected in the calculator and send you a one-page summary you can share with your finance, tax, ERP, or leadership team.</p>
      </div>

      <!-- Section 1: Selected assumptions -->
      <div class="border-t border-black/5 bg-neutral-50 px-7 py-5 md:px-9">
        <div class="text-[10.5px] font-bold uppercase tracking-[0.18em] text-violet-700">Your selected assumptions</div>
        <dl id="modal-inputs" class="mt-4 grid grid-cols-1 gap-x-6 gap-y-2.5 text-sm sm:grid-cols-2"></dl>
      </div>

      <!-- Section 2: Calculated result -->
      <div class="border-t border-black/5 px-7 py-5 md:px-9">
        <div class="text-[10.5px] font-bold uppercase tracking-[0.18em] text-red-700">Calculated result</div>
        <div id="modal-results" class="mt-4 space-y-2.5 text-sm"></div>
      </div>

      <!-- Section 3: Lead form -->
      <form id="summary-form" class="border-t border-black/5 px-7 py-6 md:px-9" novalidate>
        <div class="text-[10.5px] font-bold uppercase tracking-[0.18em] text-neutral-700">Where should we send it?</div>
        <div class="mt-4 grid grid-cols-1 gap-3 sm:grid-cols-2">
          <label class="block">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-neutral-600">Company name<span class="text-red-600">*</span></span>
            <input type="text" name="companyName" required class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-4 py-3 text-sm text-neutral-900 outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-200" placeholder="ABC Trading LLC" />
          </label>
          <label class="block">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-neutral-600">Work email<span class="text-red-600">*</span></span>
            <input type="email" name="workEmail" required class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-4 py-3 text-sm text-neutral-900 outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-200" placeholder="name@company.com" />
          </label>
          <label class="block sm:col-span-2">
            <span class="text-[11px] font-semibold uppercase tracking-wider text-neutral-600">Role <span class="text-neutral-400">(optional)</span></span>
            <select name="role" class="mt-1.5 w-full rounded-xl border border-black/10 bg-white px-4 py-3 text-sm text-neutral-900 outline-none focus:border-violet-500 focus:ring-2 focus:ring-violet-200">
              <option value="">Select a role</option>
              <option>CFO / Finance leader</option>
              <option>Tax leader</option>
              <option>IT / ERP leader</option>
              <option>Implementation partner</option>
              <option>Other</option>
            </select>
          </label>
        </div>

        <p id="form-error" class="mt-3 hidden rounded-lg bg-red-50 px-3 py-2 text-xs text-red-700 ring-1 ring-red-200"></p>

        <div class="mt-5 flex flex-col items-stretch gap-3 sm:flex-row sm:items-center sm:justify-between">
          <p class="text-xs text-neutral-500">We will send a notification to the OneSig team and email you the summary.</p>
          <button type="submit" id="submit-summary" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-[#161616] px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-black disabled:opacity-60">
            Send My Summary →
          </button>
        </div>
      </form>
