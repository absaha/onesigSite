<style>
  body { font-family: 'Inter', system-ui, -apple-system, sans-serif; background: #f7f1e7; color: #161616; -webkit-font-smoothing: antialiased; }
  .eyebrow { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.22em; text-transform: uppercase; color: rgb(109, 40, 217); }
  .tabnums { font-variant-numeric: tabular-nums; }

  /* range slider */
  input[type=range].brand{ -webkit-appearance:none; appearance:none; width:100%; height:6px; background:#ede9fe; border-radius:99px; outline:none; }
  input[type=range].brand::-webkit-slider-thumb{ -webkit-appearance:none; appearance:none; width:20px; height:20px; border-radius:50%; background:#7c3aed; border:3px solid #fff; box-shadow:0 2px 6px rgba(124,58,237,0.45); cursor:pointer; }
  input[type=range].brand::-moz-range-thumb{ width:20px; height:20px; border-radius:50%; background:#7c3aed; border:3px solid #fff; box-shadow:0 2px 6px rgba(124,58,237,0.45); cursor:pointer; }

  /* number input: keep native up/down spinners visible */
  input[type=number].brand{ width:100%; min-width:0; background:transparent; border:none; outline:none; font-weight:700; font-size:1.25rem; color:#161616; letter-spacing:-0.01em; padding-right:2px; }
  /* make spinners always visible (default is hover-only in some browsers) */
  input[type=number].brand::-webkit-inner-spin-button,
  input[type=number].brand::-webkit-outer-spin-button{ opacity:1; height:24px; cursor:pointer; }
</style>
</head>
<body>

