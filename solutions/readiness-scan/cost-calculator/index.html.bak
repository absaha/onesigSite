    <!-- SUCCESS STATE -->
    <div id="modal-success-view" class="hidden px-7 py-10 text-center md:px-12 md:py-12">
      <div class="mx-auto grid h-16 w-16 place-items-center rounded-full bg-emerald-100 ring-4 ring-emerald-50">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#059669" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>
      </div>
      <h3 class="mt-5 text-2xl font-semibold tracking-[-0.02em] text-neutral-900">Your summary request has been sent.</h3>
      <p class="mx-auto mt-3 max-w-md text-sm leading-6 text-neutral-600">We will send a one-page UAE e-invoicing exposure summary based on your selected assumptions.</p>

      <div class="mx-auto mt-7 max-w-md rounded-2xl border border-violet-200 bg-violet-50 px-5 py-4 text-left">
        <div class="text-[10.5px] font-bold uppercase tracking-[0.18em] text-violet-700">Next step</div>
        <p class="mt-1.5 text-sm font-semibold text-neutral-900">Book a Readiness Scan to walk through the gaps live.</p>
      </div>

      <div class="mt-6 flex flex-wrap justify-center gap-3">
        <a href="/solutions/readiness-scan/" class="inline-flex items-center gap-2 rounded-full bg-[#161616] px-5 py-3 text-sm font-semibold text-white shadow-sm hover:bg-black">
          Book a Readiness Scan →
        </a>
        <button type="button" id="success-close" class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-3 text-sm font-semibold text-neutral-900 ring-1 ring-black/10 hover:bg-neutral-50">
          Close
        </button>
      </div>
    </div>

  </div>
</div>

<!-- chip styles via Tailwind apply (inline) -->
<style>
  .chip{ display:inline-flex; align-items:center; padding:0.5rem 0.85rem; border-radius:0.625rem; border:1px solid rgba(0,0,0,0.10); background:#fff; font-size:0.8125rem; font-weight:500; color:#374151; transition:all .14s ease; cursor:pointer; }
  .chip:hover{ border-color:#c4b5fd; color:#6d28d9; }
  .chip.on{ background:#161616; border-color:#161616; color:#fff; font-weight:600; box-shadow:0 2px 6px rgba(0,0,0,0.15); }

  .chip-tier{ display:flex; flex-direction:column; align-items:flex-start; padding:0.65rem 0.85rem; border-radius:0.75rem; border:1px solid rgba(0,0,0,0.10); background:#fff; transition:all .14s ease; cursor:pointer; min-width:0; }
  .chip-tier:hover{ border-color:#c4b5fd; }
  .chip-tier .t{ font-family:'Inter',sans-serif; font-variant-numeric:tabular-nums; font-size:0.875rem; font-weight:700; color:#161616; letter-spacing:-0.01em; }
  .chip-tier .s{ font-size:0.6875rem; color:#6b7280; margin-top:2px; font-weight:500; }
  .chip-tier.on{ background:#161616; border-color:#161616; box-shadow:0 4px 10px rgba(0,0,0,0.20); }
  .chip-tier.on .t{ color:#fff; }
  .chip-tier.on .s{ color:#c4b5fd; }
</style>

<script>
  const VOLUME = { 'lt1k':750, '1k-10k':5000, '10k-50k':25000, '50k+':75000 };
  const VOLUME_LBL = { 'lt1k':'Under 1,000', '1k-10k':'1,000 to 10,000', '10k-50k':'10,000 to 50,000', '50k+':'50,000+' };
  const ERP_LBL    = { 50000:'Light', 150000:'Moderate', 350000:'Heavy', 750000:'Major redesign' };
  const AUDIT_LBL  = { 25000:'Basic', 100000:'Moderate', 250000:'Heavy', 500000:'Severe' };

  const state = {
    volume:'10k-50k', failure:15, fixcost:75,
    invValue:2500, delayDays:7, capRate:8,
    erp:150000, audit:100000,
  };

  // Latest computed results, kept fresh by recalc() so the modal always reads the current numbers.
  const lastResults = {
    monthlyVol:0, failed:0, threeMonthFix:0, cashAtRisk:0, collectionDelay:0,
    erpRework:0, audit:0, total:0, mainDriver:'.',
  };

  document.querySelectorAll('[data-group]').forEach(group => {
    const key = group.dataset.group;
    group.querySelectorAll('.chip, .chip-tier').forEach(c => {
      c.addEventListener('click', () => {
        group.querySelectorAll('.chip, .chip-tier').forEach(x => x.classList.remove('on'));
        c.classList.add('on');
        const v = c.dataset.val;
        if (key === 'volume')        state.volume  = v;
        else if (key === 'fixcost')  state.fixcost = parseInt(v,10);
        else if (key === 'erp')      state.erp     = parseInt(v,10);
        else if (key === 'audit')    state.audit   = parseInt(v,10);
        recalc();
      });
    });
  });

  const failureRange = document.getElementById('failure-range');
  const failureVal   = document.getElementById('failure-val');
  failureRange.addEventListener('input', e => {
    state.failure = parseInt(e.target.value,10);
    failureVal.textContent = state.failure + '%';
    recalc();
  });

  document.getElementById('inv-value').addEventListener('input', e => { const v=parseFloat(e.target.value); if(!isNaN(v)&&v>=0){ state.invValue=v; recalc(); } });
  document.getElementById('delay-days').addEventListener('input', e => { const v=parseFloat(e.target.value); if(!isNaN(v)&&v>=0){ state.delayDays=v; recalc(); } });
  document.getElementById('cap-rate').addEventListener('input', e => { const v=parseFloat(e.target.value); if(!isNaN(v)&&v>=0){ state.capRate=v; recalc(); } });

  function fmt(n) {
    n = Math.round(n);
    if (n >= 1000000) return 'AED ' + (n/1000000).toFixed(2).replace(/\.?0+$/,'') + 'M';
    if (n >= 1000)    return 'AED ' + Math.round(n/1000) + 'K';
    return 'AED ' + n.toLocaleString();
  }

  function recalc() {
    const monthlyVol      = VOLUME[state.volume] || 0;
    const failureRate     = state.failure / 100;
    const failed          = monthlyVol * failureRate;
    const threeMonthFix   = failed * state.fixcost * 3;
    const cashAtRisk      = failed * state.invValue;
    const collectionDelay = cashAtRisk * (state.capRate/100) * (state.delayDays/365);
    const erpRework       = state.erp;
    const audit           = state.audit;
    const total           = threeMonthFix + collectionDelay + erpRework + audit;

    document.getElementById('r-total').textContent = fmt(total);
    document.getElementById('r-cash').textContent  = fmt(cashAtRisk);
    document.getElementById('cmp-bad').textContent = fmt(total);

    const rows = [
      { lbl:'Failed invoice handling, 3 months', amt:threeMonthFix },
      { lbl:'ERP rework and retesting',          amt:erpRework     },
      { lbl:'Audit and evidence preparation',    amt:audit         },
      { lbl:'Delayed collections cost',          amt:collectionDelay },
    ];
    const maxAmt = Math.max(...rows.map(r=>r.amt), 1);
    const driver = rows.reduce((a,b)=> b.amt > a.amt ? b : a, rows[0]);

    const bd = document.getElementById('breakdown');
    bd.innerHTML = rows.map(r => `
      <div>
        <div class="flex items-baseline justify-between text-sm">
          <span class="text-neutral-700">${r.lbl}</span>
          <span class="font-bold tabular-nums text-neutral-900">${fmt(r.amt)}</span>
        </div>
        <div class="mt-1.5 h-1.5 w-full overflow-hidden rounded-full bg-violet-100">
          <div class="h-full rounded-full bg-gradient-to-r from-violet-500 to-violet-700" style="width:${(r.amt/maxAmt*100).toFixed(1)}%"></div>
        </div>
      </div>
    `).join('');
    document.getElementById('r-driver').textContent = driver.lbl;

    // Keep lastResults fresh for the modal.
    lastResults.monthlyVol      = monthlyVol;
    lastResults.failed          = failed;
    lastResults.threeMonthFix   = threeMonthFix;
    lastResults.cashAtRisk      = cashAtRisk;
    lastResults.collectionDelay = collectionDelay;
    lastResults.erpRework       = erpRework;
    lastResults.audit           = audit;
    lastResults.total           = total;
    lastResults.mainDriver      = driver.lbl;
  }

  recalc();

  // ============ ONE-PAGE SUMMARY MODAL ============
  const SUMMARY_ENDPOINT = 'https://formsubmit.co/ajax/abhi@onesig.co';
  const modal       = document.getElementById('summary-modal');
  const modalFormEl = document.getElementById('modal-form-view');
  const modalSuccEl = document.getElementById('modal-success-view');
  const errorEl     = document.getElementById('form-error');
  const submitBtn   = document.getElementById('submit-summary');

  function escapeHtml(s) {
    return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
  }
  function row(dt, dd) {
    return `<div><dt class="text-[11px] font-semibold uppercase tracking-wider text-neutral-500">${escapeHtml(dt)}</dt><dd class="mt-0.5 text-sm font-semibold tabular-nums text-neutral-900">${escapeHtml(dd)}</dd></div>`;
  }
  function resultRow(lbl, val, accent) {
    return `<div class="flex items-baseline justify-between gap-4 border-b border-black/5 pb-2 last:border-0 last:pb-0"><span class="text-neutral-700">${escapeHtml(lbl)}</span><span class="font-bold tabular-nums ${accent || 'text-neutral-900'}">${escapeHtml(val)}</span></div>`;
  }

  function populateModal() {
    const erpLbl   = ERP_LBL[state.erp]     || 'Custom';
    const auditLbl = AUDIT_LBL[state.audit] || 'Custom';

    document.getElementById('modal-inputs').innerHTML = [
      row('Monthly invoice volume', `${VOLUME_LBL[state.volume]} (~${lastResults.monthlyVol.toLocaleString()})`),
      row('Failure rate',            `${state.failure}%`),
      row('Cost per failed invoice', `AED ${state.fixcost}`),
      row('Average invoice value',   `AED ${state.invValue.toLocaleString()}`),
      row('Collection delay',        `${state.delayDays} days`),
      row('Cost of capital',         `${state.capRate}% / yr`),
      row('ERP rework level',        `${erpLbl} (${fmt(state.erp)})`),
      row('Audit support level',     `${auditLbl} (${fmt(state.audit)})`),
    ].join('');

    document.getElementById('modal-results').innerHTML = [
      resultRow('Estimated cost of getting it wrong', fmt(lastResults.total),         'text-red-700'),
      resultRow('Cash flow at risk',                  fmt(lastResults.cashAtRisk),    'text-amber-700'),
      resultRow('Main cost driver',                   lastResults.mainDriver,         'text-neutral-900'),
    ].join('');
  }

  function openSummaryModal() {
    populateModal();
    modalFormEl.classList.remove('hidden');
    modalSuccEl.classList.add('hidden');
    errorEl.classList.add('hidden');
    submitBtn.disabled = false;
    submitBtn.textContent = 'Send My Summary →';
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }
  function closeSummaryModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
  }

  document.getElementById('open-summary').addEventListener('click', openSummaryModal);
  document.getElementById('close-summary').addEventListener('click', closeSummaryModal);
  document.getElementById('success-close').addEventListener('click', closeSummaryModal);
  modal.addEventListener('click', e => { if (e.target === modal) closeSummaryModal(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape' && !modal.classList.contains('hidden')) closeSummaryModal(); });

  // ---- Submit ----
  document.getElementById('summary-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const form    = e.target;
    const company = form.companyName.value.trim();
    const email   = form.workEmail.value.trim();
    const role    = form.role.value || 'Not specified';

    const emailOk = /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email);
    if (!company || !emailOk) {
      errorEl.textContent = 'Please enter a valid company name and work email.';
      errorEl.classList.remove('hidden');
      return;
    }
    errorEl.classList.add('hidden');

    submitBtn.disabled    = true;
    submitBtn.textContent = 'Creating summary...';

    // Build the email-friendly payload (formsubmit emails each key/value pair).
    const erpLbl   = ERP_LBL[state.erp]     || 'Custom';
    const auditLbl = AUDIT_LBL[state.audit] || 'Custom';
    const payload  = {
      _subject:  `New UAE Calculator Summary Request - ${company}`,
      _captcha:  'false',
      _template: 'table',
      source:    'uae-cost-of-getting-it-wrong-calculator',
      companyName:                  company,
      workEmail:                    email,
      role:                         role,
      estimatedCostOfGettingItWrong: fmt(lastResults.total),
      cashFlowAtRisk:                fmt(lastResults.cashAtRisk),
      mainCostDriver:                lastResults.mainDriver,
      monthlyInvoiceVolume:          `${VOLUME_LBL[state.volume]} (~${lastResults.monthlyVol.toLocaleString()})`,
      failureRate:                   `${state.failure}%`,
      costPerFailedInvoice:          `AED ${state.fixcost}`,
      averageInvoiceValue:           `AED ${state.invValue.toLocaleString()}`,
      collectionDelayDays:           `${state.delayDays} days`,
      costOfCapital:                 `${state.capRate}%`,
      erpReworkLevel:                `${erpLbl} (${fmt(state.erp)})`,
      auditSupportLevel:             `${auditLbl} (${fmt(state.audit)})`,
      failedInvoiceHandling:         fmt(lastResults.threeMonthFix),
      erpReworkAndRetesting:         fmt(lastResults.erpRework),
      auditAndEvidencePreparation:   fmt(lastResults.audit),
      delayedCollectionsCost:        fmt(lastResults.collectionDelay),
      createdAt:                     new Date().toISOString(),
    };

    // We treat "FormSubmit returned a response" as success from the visitor's perspective.
    // FormSubmit handles activation on its side. The mailto fallback only fires on true
    // network failure (offline / DNS / fetch threw) so the visitor never sees an unexpected
    // email-client popup just because the endpoint is unactivated.
    let networkOk = false;
    try {
      await fetch(SUMMARY_ENDPOINT, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
        body: JSON.stringify(payload),
      });
      networkOk = true;
    } catch (err) {
      networkOk = false;
    }

    if (!networkOk) {
      // Genuine network failure: open the visitor's mail client so the lead is preserved.
      const lines = [
        'New one-page summary request from the UAE Cost of Getting It Wrong Calculator.',
        '',
        `Company: ${company}`,
        `Email: ${email}`,
        `Role: ${role}`,
        '',
        `Estimated cost of getting it wrong: ${fmt(lastResults.total)}`,
        `Cash flow at risk: ${fmt(lastResults.cashAtRisk)}`,
        `Main cost driver: ${lastResults.mainDriver}`,
        '',
        'Selected assumptions:',
        `- Monthly invoice volume: ${VOLUME_LBL[state.volume]} (~${lastResults.monthlyVol.toLocaleString()})`,
        `- Failure rate: ${state.failure}%`,
        `- Cost per failed invoice: AED ${state.fixcost}`,
        `- Average invoice value: AED ${state.invValue.toLocaleString()}`,
        `- Collection delay: ${state.delayDays} days`,
        `- Cost of capital: ${state.capRate}%`,
        `- ERP rework level: ${erpLbl} (${fmt(state.erp)})`,
        `- Audit support level: ${auditLbl} (${fmt(state.audit)})`,
        '',
        'Cost breakdown:',
        `- Failed invoice handling: ${fmt(lastResults.threeMonthFix)}`,
        `- ERP rework and retesting: ${fmt(lastResults.erpRework)}`,
        `- Audit and evidence preparation: ${fmt(lastResults.audit)}`,
        `- Delayed collections cost: ${fmt(lastResults.collectionDelay)}`,
        '',
        'Source: UAE Cost of Getting It Wrong Calculator',
      ].join('\n');
      const subject = `New UAE Calculator Summary Request - ${company}`;
      window.location.href = 'mailto:abhi@onesig.co?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(lines);
    }

    // Show success state. FormSubmit handles delivery (and activation, on first run) on its side.
    submitBtn.disabled    = false;
    submitBtn.textContent = 'Send My Summary →';
    modalFormEl.classList.add('hidden');
    modalSuccEl.classList.remove('hidden');
  });
</script>

</body>
</html>
